{
  "name": "@soldier0502/pwned-guard",
  "version": "0.2.0",
  "description": "Reject passwords that already appear in public breaches, without ever sending the password anywhere (k-anonymity).",
  "keywords": ["password", "security", "breach", "pwned", "k-anonymity", "authentication"],
  "license": "MIT",
  "author": "Abel Canela",
  "repository": { "type": "git", "url": "git+https://github.com/Soldier0502/pwned-guard.git" },
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "pwned-guard": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^5.9.0"
  }
}
